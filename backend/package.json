{
  "name": "backend",
  "version": "2.0.0",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node scripts/run-tests.js",
    "test:watch": "vitest",
    "test:unit": "vitest run",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:push:postgres": "prisma db push --schema prisma/schema.postgresql.prisma",
    "db:generate:postgres": "prisma generate --schema prisma/schema.postgresql.prisma",
    "db:seed": "node prisma/seed.js",
    "backup": "node scripts/backup.js",
    "lint": "eslint src tests prisma scripts",
    "format": "prettier --write \"src/**/*.{js,json}\" \"tests/**/*.js\" \"prisma/**/*.{js,prisma}\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.15.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "razorpay": "^2.9.4",
    "resend": "^6.39.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "vitest": "^5.1.2"
  }
}
